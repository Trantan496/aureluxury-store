# Prisma catalog requires this URL; missing/unreachable DB shows a catalog error within the storefront.
# Set a local password in .env. See docs/DATABASE_SETUP.md for db:start and migration.
# Future production runtime: provision and verify aurel_app first; do not change existing .env automatically.
DATABASE_URL="postgresql://aurel_app:YOUR_PASSWORD@localhost:5432/aurel_ai?schema=public"
# Migration owner credentials belong only to the separately approved deployment process, never the web runtime.
BETTER_AUTH_URL="http://localhost:3000"
# Generate a random secret of at least 32 characters locally; never commit the real value.
BETTER_AUTH_SECRET=""

# Server-only Resend credentials; leave both empty to keep email unavailable.
# EMAIL_FROM must use your verified sender/domain. Never commit the real API key.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional USD/EUR selection only; storefront defaults to explicit VND ProductPrice rows.
# Enable only AFTER reviewed multi-currency migration; legacy currency remains unassigned.
MULTI_CURRENCY_ENABLED=false

# Server-only payOS. Enable after reviewed payment migration + HTTPS webhook setup.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# Server-only local DM-VTON FastAPI inference service (keep on localhost, never expose publicly).
TRYON_SERVICE_URL="http://127.0.0.1:8001"

# Server-only Groq credentials, comma separated. Never use NEXT_PUBLIC_ for keys.
# Keys in one organization share limits; cooldown/fallback still applies.
GROQ_API_KEYS=""
GROQ_CHAT_MODEL="qwen/qwen3.8-27b"
