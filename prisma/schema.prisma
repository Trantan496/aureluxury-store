// AUREL AI - PostgreSQL relational database (MVP)
// Prisma ORM 7.x - review fields before using real customer data.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum Currency {
  VND
  USD
  EUR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TryOnStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String?   // NULL if using a trusted external identity provider
  fullName     String
  birthYear    Int?
  city         String?
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  emailVerified Boolean @default(false)
  image         String?

  sessions Session[]
  accounts Account[]

  addresses       UserAddress[]
  cart            Cart?
  orders          Order[]
  favorites       Favorite[]
  voucherRedemptions VoucherRedemption[]
  recommendations AiRecommendation[]
  tryOnSessions   VirtualTryOnSession[]
  reviews         ProductReview[]
}

// Better Auth uses serial IDs for every auth model, preserving the existing User Int PK.
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    Int      @id @default(autoincrement())
  userId                Int
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserAddress {
  id            Int     @id @default(autoincrement())
  userId        Int
  recipientName String
  phone         String
  line1         String
  district      String?
  city          String
  isDefault     Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String
  slug     String @unique

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  brand       String?
  categoryId  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  productCode String? @unique // Required for new foundation records; legacy remains unassigned.
  collection  String? // Normalized collection slug, no separate collection lifecycle yet.
  updatedAt   DateTime? // Database trigger after staged deployment; no implicit old-schema writes.
  profile     ProductProfile?
  draftRequest ProductDraftRequest?
  lookEntries PendingProduct[] @relation("LookSource")
  pendingOrigin PendingProduct? @relation("PendingResult")

  category        Category           @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  favorites       Favorite[]
  recommendations AiRecommendation[]
  reviews         ProductReview[]

  @@index([categoryId])
}

// Idempotent Step1 creation; additive workflow table, independent of taxonomy registry.
model ProductDraftRequest {
  key String @id
  actorId Int
  productId Int @unique
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  sku       String  @unique
  color     String
  size      String
  price     Decimal? @db.Decimal(12, 2) // Legacy amount: currency is unknown; never auto-backfill.
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  product       Product               @relation(fields: [productId], references: [id])
  prices        ProductPrice[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  tryOnSessions VirtualTryOnSession[]
  images        ProductImage[]

  @@unique([productId, color, size])
  @@unique([id, productId])
  @@index([productId])
}

model ProductPrice {
  id        Int      @id @default(autoincrement())
  variantId Int
  currency  Currency
  amount    Decimal  @db.Decimal // Unconstrained NUMERIC; SQL CHECK rejects excess scale before rounding.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([variantId, currency])
  @@index([currency, amount])
}

model ImageAsset {
  id String @id
  data Bytes
  mimeType String
  width Int
  height Int
  byteSize Int
  createdAt DateTime @default(now())
  pendingProducts PendingProduct[]
  @@index([createdAt, id])
}

// Editorial intake is not saleable inventory; conversion uses the normal Product validators.
model PendingProduct {
  id Int @id @default(autoincrement())
  requestKey String @unique
  createdById Int
  sourceProductId Int?
  productId Int? @unique
  state String @default("pending")
  name String?
  proposedPrice Decimal? @db.Decimal
  imageAssetId String?
  revision Int @default(0)
  createdAt DateTime @default(now())
  source Product? @relation("LookSource", fields:[sourceProductId],references:[id],onDelete:SetNull)
  product Product? @relation("PendingResult",fields:[productId],references:[id],onDelete:SetNull)
  imageAsset ImageAsset? @relation(fields:[imageAssetId],references:[id],onDelete:Restrict)
  @@index([sourceProductId,id])
  @@index([state,id])
}

model ProductImage {
  id         Int     @id @default(autoincrement())
  productId  Int
  storageKey String  // Public asset path; uploaded binary is held separately in ImageAsset.
  altText    String?
  sortOrder  Int     @default(0)
  variantId Int?
  imageType String? // front/back/detail/lifestyle/other; NULL means not classified.
  isPrimary Boolean @default(false)
  sourceReference String?
  websitePermission String @default("unknown")
  embeddingPermission String @default("unknown")
  trainingPermission String @default("unknown")
  rightsReference String?

  product Product @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)

  @@index([productId])
  @@index([variantId, productId])
}

// One source for descriptive options and AI taxonomy, never copies variant color/size.
model ProductProfile {
  productId Int @id
  collar String?
  fabric String?
  gender String?
  ageGroup String?
  fit String?
  garmentType String?
  styleTags String[] @default([])
  seasonTags String[] @default([])
  occasionTags String[] @default([])
  layerRole String?
  pattern String?
  silhouette String?
  dynamicAttributes Json @default("{}") // Type-specific, controlled attributes; keys are in productTypeAttributes.
  taxonomyVersion String @default("aurel-fashion-v1")
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([gender, garmentType])
  @@index([fabric, fit])
}

// Staged Phase2.9.3: table existence is checked before reads on unchanged main.
model TaxonomyOption {
  key String
  token String
  label String
  hex String? // Optional colour metadata, staged; existing token remains its identity.
  createdAt DateTime @default(now())
  @@id([key, token])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id              Int         @id @default(autoincrement())
  revision        BigInt      @default(0) // Database-owned concurrency token, never accepted from request JSON.
  orderNumber     String      @unique
  userId          Int
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal
  subtotalAmount  Decimal?    @db.Decimal
  discountAmount  Decimal     @default(0) @db.Decimal
  voucherCode     String?
  currency        Currency?   // NULL preserves historical orders whose currency has not been verified.
  shippingName    String
  shippingPhone   String
  shippingAddress String
  createdAt       DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
  voucherRedemption VoucherRedemption?
  onlinePayment OnlinePayment?

  @@index([userId, createdAt])
  @@index([currency, createdAt])
}

// Presence identifies PAYOS; historical/COD orders need no backfill.
model OnlinePayment {
  orderId Int @id
  provider String @default("PAYOS")
  paidAt DateTime?
  reconciliationRequired Boolean @default(false)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]
}

model PaymentAttempt {
  orderCode BigInt @id @default(autoincrement())
  orderId Int
  expectedAmount Decimal @db.Decimal(16, 0)
  status String @default("PROCESSING")
  paymentLinkId String? @unique
  checkoutUrl String?
  qrCode String?
  bankBin String?
  accountName String?
  accountNumber String?
  description String
  reference String? @unique
  transactionReferences String[] @default([])
  paidAmount Decimal? @db.Decimal(16, 0)
  paidAt DateTime?
  expiresAt DateTime
  leaseUntil DateTime?
  lastCheckedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment OnlinePayment @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  receipts PaymentReceipt[]
  @@index([orderId, createdAt])
}

model PaymentReceipt {
  reference String @id
  orderCode BigInt
  amount Decimal @db.Decimal(16, 0)
  currency String
  receivedAt DateTime @default(now())
  attempt PaymentAttempt @relation(fields: [orderCode], references: [orderCode], onDelete: Restrict)
  @@index([orderCode])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  variantId   Int
  productName String  // snapshot when placing an order
  sku         String
  color       String
  size        String
  quantity    Int
  unitPrice   Decimal @db.Decimal // price snapshot, no live ProductPrice dependency
  currency    Currency?
  lineTotal   Decimal? @db.Decimal

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  reviews ProductReview[]

  @@index([orderId])
}

model Voucher {
  id Int @id @default(autoincrement())
  code String @unique
  kind String
  value Decimal @db.Decimal
  minSubtotal Decimal @default(0) @db.Decimal
  maxDiscount Decimal? @db.Decimal
  startsAt DateTime
  endsAt DateTime
  usageLimit Int?
  perUserLimit Int @default(1)
  isActive Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  redemptions VoucherRedemption[]
}

model VoucherRedemption {
  id Int @id @default(autoincrement())
  voucherId Int
  userId Int
  orderId Int @unique
  codeSnapshot String
  discountAmount Decimal @db.Decimal
  createdAt DateTime @default(now())
  releasedAt DateTime?
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([voucherId, userId, releasedAt])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model AiRecommendation {
  id           Int      @id @default(autoincrement())
  userId       Int
  productId    Int
  score        Float
  modelVersion String
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId, createdAt])
}

model VirtualTryOnSession {
  id             Int         @id @default(autoincrement())
  userId         Int
  variantId      Int
  inputImageKey  String?      // Refer to private object storage
  outputImageKey String?      // Refer to private object storage
  status         TryOnStatus @default(QUEUED)
  createdAt      DateTime    @default(now())
  expiresAt      DateTime?

  user    User           @relation(fields: [userId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([userId, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

// Standalone scalar references; SQL migration enforces product/user foreign keys.
model ProductDiscussion {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  parentId  Int?
  reviewId  Int?     @unique
  commentId Int?     @unique
  body      String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
  @@index([parentId])
}

model ProductDiscussionLike {
  discussionId Int
  userId       Int
  @@id([discussionId, userId])
}

model ProductDiscussionImage {
  id           String @id @db.Uuid
  discussionId Int
  bytes        Bytes
  width        Int
  height       Int
  @@index([discussionId])
}

model ProductComment {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductReview {
  id             Int          @id @default(autoincrement())
  productId      Int
  userId         Int
  orderItemId    Int?
  rating         Int
  comment        String
  status         ReviewStatus @default(PENDING)
  adminReply     String?
  adminRepliedAt DateTime?
  moderatedById  Int?
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}
